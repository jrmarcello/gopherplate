# Binários
/bin/
/gopherplate
/perfcompare
/tests/load/cmd/perfcompare/perfcompare

# Learning loop (local-only — privado por dev). The whole .claude/learning/
# directory is per-dev runtime state: SQLite DB, JSONL audit log, generated
# config.yml, and an internal .gitignore created by `learn init`. None of
# these belong in the repo. The legacy specific-file patterns (db.sqlite,
# learn.log, state/) are kept below as a defense-in-depth in case someone
# `git add`s a child explicitly.
.claude/learning/
.claude/learning/db.sqlite
.claude/learning/db.sqlite-*
.claude/learning/learn.log
.claude/learning/state/
*.exe
*.exe~
*.dll
*.so
*.dylib

# Saída de testes (tudo em tests/)
tests/coverage/
tests/load/results/

# Generated (proto stubs)
gen/

# Dependências
/vendor/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Arquivos de sistema
.DS_Store
Thumbs.db

# Arquivos de ambiente
.env
.env.*
!.env.example

# Claude Code
.claude/settings.local.json
.claude/worktrees/
.claude/agent-memory/
# Catch nested .claude/agent-memory/ created by sub-agents inside any
# nested module (e.g. tools/learn/.claude/agent-memory/) — the rule above
# is anchored to the repo root, so we also need the recursive glob below.
**/.claude/agent-memory/

# Logs
*.log

# Temporários
*.tmp

# Review reports (generated, ephemeral)
docs/review-report-*.md

roadmap.md
/tools/learn/bin/
